# EXIT: 150
extern "kernel32.dll" fun ExitProcess(code: i64): void
type StructArrayToken {
    kind: i64
    value: i64
}
fun main(): void {
    let tokens = new StructArrayToken[1]
    push(tokens, new StructArrayToken)
    tokens.data[0].kind = 100
    tokens.data[0].value = 50
    ExitProcess(tokens.data[0].kind + tokens.data[0].value)
}
