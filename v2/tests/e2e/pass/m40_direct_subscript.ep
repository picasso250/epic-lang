# EXIT: 0
# STDOUT: B42
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let text = "ABC"
    if text[1] != 66 {
        ExitProcess(1)
    }
    print(str_new(text.data + 1, 1))
    let values = new i64[1]
    values[0] = 42
    print(itoa(values[0]))
    print("\n")
}
