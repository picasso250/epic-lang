# EXIT: 0
# CLEAN: test_out.txt
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let s = "42"
    let n = write_file("test_out.txt", bytes(s))
    let inp = read_file("test_out.txt")
    if n != 2 || len(inp) != 2 || inp[0] != '4' || inp[1] != '2' {
        ExitProcess(1)
    }
    ExitProcess(0)
}
