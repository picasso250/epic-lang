# EXIT: 0
# STDOUT: 1
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun fail(): i64 {
    ExitProcess(9)
    ret 0
}
fun main(): void {
    if 1 == 1 || fail() == 1 {
        if 1 != 1 && fail() == 0 {
            ExitProcess(8)
        }
    } else {
        ExitProcess(7)
    }
    let value = 2 < 3 && 4 >= 4
    if value {
        print("1")
        ExitProcess(0)
    }
    ExitProcess(6)
}
