# EXIT: 0
# STDOUT: abc
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let empty = new u8[]
    if len(str(empty)) != 0 {
        ExitProcess(1)
    }
    let data = bytes("abc")
    let text = str(data)
    data[0] = 'z'
    if len(text) != 3 || text.data[0] != 'a' || text.data[1] != 'b' || text.data[2] != 'c' {
        ExitProcess(2)
    }
    print(text)
    ExitProcess(0)
}
