# EXIT: 0
extern "kernel32.dll" fun ExitProcess(code: i64): void
type NullProbeNode {
    next: NullProbeNode
}

type NullProbeHolder {
    text: str
    values: u8[]
    node: NullProbeNode
}

fun main(): void {
    let holder = new NullProbeHolder
    let shadow_check = 7
    if shadow_check != 7 {
        ExitProcess(5)
    }
    if !is_null(holder.text) || !is_null(holder.values) || !is_null(holder.node) {
        ExitProcess(1)
    }

    holder.text = ""
    holder.values = new u8[]
    holder.node = new NullProbeNode
    if is_null(holder.text) || is_null(holder.values) || is_null(holder.node) {
        ExitProcess(2)
    }

    if is_null(new NullProbeNode) {
        ExitProcess(4)
    }
    ExitProcess(0)
}
