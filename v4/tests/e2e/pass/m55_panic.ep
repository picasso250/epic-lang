# EXIT: 1
# STDOUT: evaluated once
# STDERR: Epic panic: unexpected state
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun panic_message(): str {
    print("evaluated once\n")
    ret "unexpected state"
}
fun panic_value(flag: bool): i64 {
    if flag {
        ret 7
    } else {
        panic(panic_message())
    }
}
fun main(): void {
    ExitProcess(panic_value(false))
}
