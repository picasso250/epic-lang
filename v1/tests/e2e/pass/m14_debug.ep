# EXIT: 0
extern "kernel32.dll" fun ExitProcess(code: i64): void
type DebugToken {
    kind: i64
    value: i64
}
fun main(): void {
    let tokens = new DebugToken[]
    push(tokens, new DebugToken)
    push(tokens, new DebugToken)
    push(tokens, new DebugToken)
    tokens.data[2].kind = 42
    ExitProcess(0)
}
