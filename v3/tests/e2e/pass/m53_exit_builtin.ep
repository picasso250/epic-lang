# EXIT: 42
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun stop_now(): i64 {
    exit(42)
}
fun choose_exit(flag: i64): i64 {
    if flag {
        ret 7
    } else {
        exit(42)
    }
}
fun main(): void {
    if len(argv) == 0 {
        let ignored_stop = stop_now()
    }
    ExitProcess(choose_exit(0))
}
