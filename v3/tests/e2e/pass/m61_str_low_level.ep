# EXIT: 0
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let text = "abcd"
    let middle = text[1:3]
    let rebuilt = str_new(middle.data, middle.len)
    let shifted = str_new(text.data + 1, 2)
    if middle.len == 2 && rebuilt == "bc" && shifted == "bc" {
        ExitProcess(0)
    }
    ExitProcess(1)
}
