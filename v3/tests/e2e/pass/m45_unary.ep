# EXIT: 0
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let five = 5
    if -five != -5 || --five != 5 {
        ExitProcess(1)
    }
    if -2 * 3 != -6 || -(2 + 3) != -5 {
        ExitProcess(2)
    }
    if !false != true || !true != false || !!true != true || !false != true {
        ExitProcess(3)
    }
    if !(1 == 2) != true || !("left" == "right") != true {
        ExitProcess(4)
    }
    if !false {
        let reached = 1
        if reached == 0 {
            ExitProcess(5)
        }
    } else {
        ExitProcess(6)
    }
    if !true {
        ExitProcess(7)
    }
    let minimum = -9223372036854775807 - 1
    if minimum >= 0 {
        ExitProcess(8)
    }
}
