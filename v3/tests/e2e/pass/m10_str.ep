# EXIT: 0
# STDOUT: hellobye!
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let s = "hello"
    print(s)
    let t = "hello"
    if s == t {
        print("bye")
    } else {
        print("no")
    }
    if s != "world" {
        print("!")
    }
    ExitProcess(0)
}
