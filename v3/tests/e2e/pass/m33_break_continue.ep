# EXIT: 0
# STDOUT: 1
# STDOUT: 3
# STDOUT: 4
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun main(): void {
    let i = 0
    for i < 10 {
        i = i + 1
        if i == 2 {
            continue
        }
        if i == 5 {
            break
        }
        print(itoa(i))
        print("\n")
    }
    ExitProcess(0)
}
