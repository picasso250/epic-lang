# EXIT: 0
# STDOUT: 200
extern "kernel32.dll" fun ExitProcess(code: i64): void
type FunctionPoint {
    x: i64
    y: i64
}
fun sum(p: FunctionPoint): i64 {
    ret p.x + p.y
}
fun main(): void {
    let p = new FunctionPoint
    p.x = 100
    p.y = 100
    print(itoa(sum(p)))
    print("\n")
    ExitProcess(0)
}
