# EXIT: 150
extern "kernel32.dll" fun ExitProcess(code: i64): void
type StructArrayToken {
    kind: i64
    value: i64
}
fun main(): void {
    let tokens = new StructArrayToken[]
    push(tokens, new StructArrayToken)
    tokens[0].kind = 100
    tokens[0].value = 50
    ExitProcess(tokens[0].kind + tokens[0].value)
}
