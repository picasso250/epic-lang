# EXIT: 0
extern "kernel32.dll" fun ExitProcess(code: i64): void
fun to_upper(c: u8): i64 {
    let n = i64(c)
    if n >= i64('a') && n <= i64('z') {
        ret n - 32
    }
    ret n
}
fun narrow_return(): u8 {
    ret u8(300)
}
fun main(): void {
    let buf = new u8[]
    push(buf, 255)
    if to_upper('h') != i64('H') || to_upper('i') != i64('I') || to_upper('z') != 90 || i64(narrow_return()) != 44 || buf[0] != 255 {
        ExitProcess(1)
    }
    ExitProcess(0)
}
